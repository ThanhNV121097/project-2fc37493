# Local PostgreSQL role.
POSTGRES_USER=app
# Local PostgreSQL password. Replace outside development.
POSTGRES_PASSWORD=app_secret
# Local PostgreSQL database.
POSTGRES_DB=app
# Host ports for local compose.
BACKEND_PORT=8080
FRONTEND_PORT=3000
# Browser API URL.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Server-side API origin.
API_ORIGIN=http://backend:8080
